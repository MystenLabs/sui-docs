.cache/
node_modules/
sites/*/.generated/
sites/*/.resolved/
sites/*/build/
sites/*/.docusaurus/

# Generated content. Ported from the three .gitignore files in MystenLabs/sui
# (root, docs/, docs/content/) with the paths rebased onto content/sui. The
# negations matter: each one names a hand-written page that sits inside an
# otherwise generated directory, and dropping it would untrack a real page.
content/sui/references/framework/**
content/sui/references/sui-api/sui-graphql/*
content/sui/references/release-notes.mdx
content/sui/references/awesome-sui.mdx
content/sui/references/awesome-sui/
content/sui/references/awesome-sui-gaming.mdx
content/sui/references/awesome-sui-gaming/
content/sui/documentation.json
content/sui/**/subtree/**/*.mdx

content/sui/sui-stack/seal/*.mdx
!content/sui/sui-stack/seal/sui-stack-seal.mdx
content/sui/sui-stack/messaging/*.mdx
!content/sui/sui-stack/messaging/index.mdx
!content/sui/sui-stack/messaging/chat-app.mdx

sites/sui/static/sui-stack/

# Fetch cache for the mirrored external docs.
.cache-external-docs/

# Generated by src/shared/js/generate-llmstxt.mjs on every build. These were
# tracked upstream, which is how a hand-added section to llms.txt survived in a
# commit and was absent from the deployed file. The content now comes from
# src/data/docs-sites.json instead.
sites/*/static/llms.txt
sites/*/static/llms-full.txt
sites/*/static/awesome-sui/

# Mirrored content, materialised on demand rather than committed.
#
# These seven sources are `ownership: mirrored` in sources.json: their pages are
# authored, reviewed and published by the repository that owns them. Committing a
# copy here meant a guard to stop anyone editing it, a forward-port to let them
# edit it anyway, and a bot writing to main several times a day, all to maintain
# a tree nothing in this repo read. The code sources under .cache/ have always
# worked the other way and have never needed any of it.
#
# To get the whole corpus locally, for an audit or a cross-product search:
#
#   node scripts/fetch-sources.js && node scripts/mirror.js
#
# A source that actually moves here changes to `ownership: moved`, and its pages
# become this repo's own: tracked, edited and reviewed here like content/sui.
content/walrus/
content/suins/
content/hashi/
content/move-book/
content/ts-sdks/
content/oyster/
content/walrus-memory/
