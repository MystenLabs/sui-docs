{
  "$comment": [
    "Every external source this repository renders, in one place.",
    "",
    "ownership tells you who edits a source and therefore how it behaves here:",
    "  moved    the pages live in this repo and are edited here.",
    "  mirrored the pages live in the source repo, are edited there, and are",
    "           committed here read-only by the mirror job. A pull request that",
    "           edits a mirrored path is forwarded to the source repo rather",
    "           than merged here. Their pages are not committed here; see .gitignore.",
    "",
    "ref pins what gets fetched. 'main' tracks the source's default branch;",
    "a tag or SHA freezes it. The three sources outside the MystenLabs org",
    "should be pinned to a SHA rather than a branch someone else controls.",
    "",
    "preserve lists files inside a mirrored target that are authored HERE and",
    "must survive the mirror's clean-and-rewrite. They are exempt from the guard."
  ],
  "sources": {
    "walrus": {
      "ownership": "mirrored",
      "repo": "MystenLabs/walrus",
      "ref": "main",
      "sourcePath": "docs/content",
      "targetPath": "content/walrus",
      "transforms": [
        "links"
      ],
      "linkPrefix": "/walrus",
      "preserve": [],
      "exclude": []
    },
    "suins": {
      "ownership": "mirrored",
      "repo": "MystenLabs/suins-contracts",
      "ref": "main",
      "sourcePath": "documentation/content",
      "targetPath": "content/suins",
      "transforms": [
        "links"
      ],
      "linkPrefix": "/suins",
      "preserve": [],
      "exclude": []
    },
    "hashi": {
      "ownership": "mirrored",
      "repo": "MystenLabs/hashi",
      "ref": "main",
      "sourcePath": "design/docs",
      "targetPath": "content/hashi",
      "transforms": [
        "links"
      ],
      "linkPrefix": "/hashi",
      "preserve": [],
      "exclude": []
    },
    "move-book": {
      "ownership": "mirrored",
      "repo": "MystenLabs/move-book",
      "ref": "main",
      "sourcePath": "book",
      "targetPath": "content/move-book",
      "transforms": [
        "links"
      ],
      "linkPrefix": "/move-book",
      "preserve": [],
      "exclude": []
    },
    "ts-sdks": {
      "ownership": "mirrored",
      "repo": "MystenLabs/ts-sdks",
      "ref": "main",
      "sourcePath": "packages/docs/content",
      "targetPath": "content/ts-sdks",
      "transforms": [],
      "linkPrefix": "/ts-sdks",
      "preserve": [],
      "exclude": [],
      "note": "Fumadocs MDX, not Docusaurus MDX. Mirrored for one searchable tree and one audit pipeline; its own site keeps building it."
    },
    "oyster": {
      "ownership": "mirrored",
      "repo": "MystenLabs/oyster",
      "ref": "main",
      "sourcePath": "docs/src",
      "targetPath": "content/oyster",
      "transforms": [
        "links"
      ],
      "linkPrefix": "/oyster",
      "preserve": [],
      "exclude": []
    },
    "walrus-memory": {
      "ownership": "mirrored",
      "repo": "MystenLabs/MemWal",
      "ref": "dev",
      "sourcePath": "docs",
      "targetPath": "content/walrus-memory",
      "transforms": [
        "links"
      ],
      "linkPrefix": "/walrus-memory",
      "preserve": [],
      "exclude": []
    }
  },
  "codeSources": {
    "$comment": "Fetched so pages can quote and verify source. Never written back, never rendered as pages. The ones outside MystenLabs are called out because nobody here controls their branches.",
    "sui": {
      "repo": "MystenLabs/sui",
      "ref": "main",
      "paths": [
        "crates",
        "examples",
        "release-notes"
      ]
    },
    "ts-sdks": {
      "repo": "MystenLabs/ts-sdks",
      "ref": "main",
      "paths": [
        "packages"
      ]
    },
    "deepbookv3": {
      "repo": "MystenLabs/deepbookv3",
      "ref": "main",
      "paths": [
        "packages"
      ]
    },
    "sui-apis": {
      "repo": "MystenLabs/sui-apis",
      "ref": "gen-docs",
      "paths": [
        "documentation.json"
      ]
    },
    "playtron-sdk": {
      "repo": "playtron-os/playtron-sdk",
      "ref": "main",
      "paths": [
        "."
      ],
      "external": true
    },
    "awesome-sui": {
      "repo": "sui-foundation/awesome-sui",
      "ref": "main",
      "paths": [
        "."
      ]
    },
    "awesome-sui-gaming": {
      "repo": "becky-sui/awesome-sui-gaming",
      "ref": "main",
      "paths": [
        "."
      ]
    }
  }
}
